{
  "opencollection": "1.0.0",
  "info": {
    "name": "Emplifi (Socialbakers) Public Ads Posts API",
    "version": "3"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
